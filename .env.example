# OpenWeatherMap API anahtarı — https://home.openweathermap.org/api_keys
OWM_API_KEY=

# Favoriler/geçmişi sunucuda saklamak için (opsiyonel):
# Vercel Dashboard > Storage > Marketplace Database Providers > Upstash Redis
# ile bir veritabanı oluşturup projene bağladığında aşağıdaki değişkenler
# Vercel tarafından otomatik eklenir; yerelde çalışmak için
# `vercel env pull .env` ile çekebilirsin.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
